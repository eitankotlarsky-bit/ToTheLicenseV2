<Window x:Class="NavigationApp.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register New Teacher" Height="650" Width="525"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#FFF" Margin="0,0,55,29">
        <Border CornerRadius="12" Background="White" Margin="20,20,-25,0">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="15" Opacity="0.3" Color="#444"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center" Margin="30">
                <TextBlock Text="Register New Teacher"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#333"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <Label Content="Username"/>
                <TextBox x:Name="UsernameTextBox" Margin="0,0,0,10"/>

                <Label Content="Password"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,10"/>

                <Label Content="Email"/>
                <TextBox x:Name="EmailTextBox" Margin="0,0,0,10"/>

                <Label Content="First Name"/>
                <TextBox x:Name="FirstNameTextBox" Margin="0,0,0,10"/>

                <Label Content="Last Name"/>
                <TextBox x:Name="LastNameTextBox" Margin="0,0,0,10"/>

                <Label Content="Start Work Date"/>
                <DatePicker x:Name="StartWorkDatePicker" Margin="0,0,0,20"/>

                <Button Content="Register"
                        x:Name="RegisterButton"
                        Height="40"
                        Margin="0,10,0,0"
                        Background="#007ACC"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="RegisterButton_Click"/>
                <Button Content="Back"
                        x:Name="BackButton"
                        Height="40"
                        Margin="0,10,0,0"
                        Background="#AAAAAA"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="BackButton_Click"/>
                <TextBlock x:Name="ErrorMessageTextBlock"
                           Foreground="Red"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
