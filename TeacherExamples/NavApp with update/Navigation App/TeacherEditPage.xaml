<Page x:Class="NavigationApp.TeacherEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6F8"
      FontFamily="Segoe UI"
      Title="Edit Teacher">
    <Page.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00A3FF"/>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E6EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,6,0,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E6EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,6,0,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="BorderBrush" Value="#D3D8DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F4F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1.2*" />
        </Grid.ColumnDefinitions>

        <!-- Card: Form -->
        <Border Grid.Column="0" CornerRadius="12" Background="White" Padding="24" Margin="0,0,16,0" >
            <StackPanel>
                <TextBlock Text="Edit Teacher" FontSize="22" FontWeight="Bold" Foreground="#111" Margin="0,0,0,12"/>
                <TextBlock Text="Update personal information and employment date." Foreground="#666" FontSize="13" Margin="0,0,0,18"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <Label Content="Username"/>
                        <TextBox x:Name="UsernameTextBox" Style="{StaticResource ModernTextBox}"/>

                        <Label Content="Password"/>
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPasswordBox}"/>

                        <Label Content="Email"/>
                        <TextBox x:Name="EmailTextBox" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <Label Content="First Name"/>
                        <TextBox x:Name="FirstNameTextBox" Style="{StaticResource ModernTextBox}"/>

                        <Label Content="Last Name"/>
                        <TextBox x:Name="LastNameTextBox" Style="{StaticResource ModernTextBox}"/>

                        <Label Content="Start Work Date"/>
                        <DatePicker x:Name="StartWorkDatePicker" Margin="0,6,0,12" Padding="8" Background="White" BorderBrush="#E1E6EB" BorderThickness="1"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ErrorMessageTextBlock" Foreground="#D9534F" Margin="0,6,0,0" FontWeight="SemiBold"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Width="110" Click="CancelButton_Click">Cancel</Button>
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Width="110" Margin="12,0,0,0" Click="SaveButton_Click">Save</Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Card: Preview / Info -->
        <Border Grid.Column="1" CornerRadius="12" Background="White" Padding="20">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Ellipse Width="92" Height="92" Fill="#E8F4FF"/>
                    <TextBlock Text="👩‍🏫" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock x:Name="PreviewName" Text="{Binding FullName}" FontSize="16" FontWeight="Bold" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                <TextBlock x:Name="PreviewEmail" Text="email@example.com" Foreground="#666" FontSize="13" Margin="0,4,0,12" HorizontalAlignment="Center"/>

                <StackPanel Orientation="Vertical" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="PreviewUsername" Text="Username:   " VerticalAlignment="Center"/>
                        <TextBlock x:Name="Username" Text="{Binding UserName}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="PreviewStartDate" Text="Start Date:  " VerticalAlignment="Center"/>
                        <TextBlock x:Name="StartDate" Text="{Binding StartWorkDate}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <Separator Margin="0,16,0,12"/>

                <TextBlock Text="Tips" FontWeight="Bold" Margin="0,6,0,6"/>
                <TextBlock Text="Keep password under 15 characters." Foreground="#666" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="Use a professional email address." Foreground="#666" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>