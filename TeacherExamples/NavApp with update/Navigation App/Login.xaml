<Window x:Class="NavigationApp.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="350"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        FontFamily="Segoe UI">
    
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF007ACC"/>

        <Style x:Key="CloseButtonTheme" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF0099FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF005FAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="White" Margin="10">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="15" Opacity="0.3" Color="#444"/>
        </Border.Effect>

        <Grid>
            <Button x:Name="CloseButton" 
                    Content="X" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top" 
                    Margin="0,5,5,0"
                    Style="{StaticResource CloseButtonTheme}"
                    Click="CloseButton_Click"/>

            <StackPanel VerticalAlignment="Center" Margin="35,40,35,35">

                <TextBlock Text="LOGIN" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="#333" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,25"/>

                <Label Content="Username" 
                       Foreground="#555" 
                       FontWeight="Medium" 
                       Margin="0,0,0,5"/>
                <Border x:Name="UsernameBorder" 
                        CornerRadius="8" 
                        BorderBrush="#CCC" 
                        BorderThickness="1" 
                        Background="White"
                        Margin="0,0,0,15">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#CCC"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=UsernameTextBox, Path=IsKeyboardFocused}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox x:Name="UsernameTextBox" 
                             BorderThickness="0" 
                             Padding="8" 
                             Background="Transparent"
                             FontSize="14"/>
                </Border>

                <Label Content="Password" 
                       Foreground="#555" 
                       FontWeight="Medium" 
                       Margin="0,0,0,5"/>
                <Border x:Name="PasswordBorder" 
                        CornerRadius="8" 
                        BorderBrush="#CCC" 
                        BorderThickness="1" 
                        Background="White"
                        Margin="0,0,0,20">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#CCC"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=PasswordInputBox, Path=IsKeyboardFocused}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <PasswordBox x:Name="PasswordInputBox" 
                                 BorderThickness="0" 
                                 Padding="8" 
                                 Background="Transparent"
                                 FontSize="14"/>
                </Border>

                <Button x:Name="LoginButton" 
                        Content="Login" 
                        Margin="0,10,0,10"
                        Style="{StaticResource ModernButton}"
                        Click="LoginButton_Click"/>
                <Button x:Name="RegisterButton"
                        Content="Register"
                        Margin="0,0,0,10"
                        Style="{StaticResource ModernButton}"
                        Click="RegisterButton_Click"/>
                <TextBlock x:Name="ErrorMessageTextBlock" 
                           Foreground="Red" 
                           TextWrapping="Wrap" 
                           HorizontalAlignment="Center"
                           MinHeight="30" 
                           Margin="0,10,0,0"/>

            </StackPanel>
        </Grid>
    </Border>
</Window>