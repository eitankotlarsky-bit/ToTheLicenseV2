<Window x:Class="ToTheLicense.HomePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="לרישיון - דף הבית"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"   
        WindowStyle="None"
        Background="#F7F9FC"
        FontFamily="Segoe UI"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#002366"/>
        <SolidColorBrush x:Key="AccentYellow" Color="#FFDDA800"/>
        <SolidColorBrush x:Key="TextDark" Color="#222222"/>
        <SolidColorBrush x:Key="TextLight" Color="#666666"/>

        <Style x:Key="HeroCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.1" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentYellow}"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFC107"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#EEE"/>
                                <Setter Property="Foreground" Value="#AAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource PrimaryBlue}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="62,0,-22,0">
                <Grid Width="48" Height="48" Margin="0,0,12,0">
                    <Rectangle Fill="#4c6ef5" RadiusX="10" RadiusY="10"/>
                    <Polygon Points="24,8 8,40 40,40" Fill="White"/>
                    <TextBlock Text="ל" FontSize="22" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                </Grid>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="לרישיון" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="WelcomeText" Text="שלום, משתמש" Foreground="#DDD" FontSize="14"/>
                </StackPanel>
            </StackPanel>

            <Button Content="יציאה" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0" 
                    Background="Transparent" Foreground="White" BorderThickness="0" Click="Logout_Click" Cursor="Hand"/>
        </Grid>

        <Grid Grid.Row="1" Margin="30">

            <Grid x:Name="StudentDashboard" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <Border Style="{StaticResource HeroCard}" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="ההתקדמות שלך לרישיון" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                            <Grid Margin="0,15">
                                <ProgressBar x:Name="LicenseProgress" Height="20" Value="0" Maximum="28" Foreground="#4CAF50" Background="#EEE" BorderThickness="0"/>
                                <TextBlock x:Name="ProgressText" Text="0/28 שיעורים" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                            </Grid>
                            <TextBlock Text="כל הכבוד! המשך כך." FontSize="14" Foreground="{StaticResource TextLight}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HeroCard}" Padding="20" Background="#E3F2FD" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="השיעור הקרוב" FontSize="16" Foreground="#1565C0" FontWeight="Bold"/>
                                <TextBlock x:Name="NextLessonDate" Text="אין שיעורים עתידיים" FontSize="24" FontWeight="Bold" Margin="0,5" Foreground="{StaticResource TextDark}"/>
                                <TextBlock x:Name="NextLessonDetails" Text="הזמן שיעור עכשיו כדי להתקדם!" FontSize="16" Foreground="{StaticResource TextLight}"/>
                            </StackPanel>
                            <TextBlock Text="🚗" FontSize="40" Grid.Column="1" VerticalAlignment="Center" Opacity="0.5"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource HeroCard}" Padding="20" Background="White">
                        <StackPanel>
                            <TextBlock Text="הדרך לרישיון 🏁" FontSize="18" FontWeight="Bold" Foreground="#002366" Margin="0,0,0,20"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.5*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="0.5*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <Border x:Name="StepTheory" Width="60" Height="60" CornerRadius="30" Background="#E0E0E0" Margin="0,0,0,10">
                                        <TextBlock Text="📚" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="תיאוריה" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTheoryStatus" Text="טרם בוצע" FontSize="12" Foreground="Gray" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <Rectangle x:Name="Line1" Grid.Column="2" Height="4" VerticalAlignment="Top" Margin="10,28,10,0" Fill="#E0E0E0"/>

                                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                    <Border x:Name="StepInternal" Width="60" Height="60" CornerRadius="30" Background="#E0E0E0" Margin="0,0,0,10">
                                        <TextBlock Text="🏫" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="טסט פנימי" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtInternalStatus" Text="נעול" FontSize="12" Foreground="Gray" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <Rectangle x:Name="Line2" Grid.Column="4" Height="4" VerticalAlignment="Top" Margin="10,28,10,0" Fill="#E0E0E0"/>

                                <StackPanel Grid.Column="5" HorizontalAlignment="Center">
                                    <Border x:Name="StepExternal" Width="60" Height="60" CornerRadius="30" Background="#E0E0E0" Margin="0,0,0,10">
                                        <TextBlock Text="🚗" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="טסט חיצוני" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <Button x:Name="BtnRequestTest" Content="בקש טסט" FontSize="11" Padding="10,4" Margin="0,5,0,0" 
                                            Background="#FFDDA800" BorderThickness="0" FontWeight="Bold" Cursor="Hand"
                                            Visibility="Collapsed" Click="RequestExternalTest_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="10"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <TextBlock x:Name="TxtExternalStatus" Text="נעול" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" Visibility="Visible"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="פעולות מהירות" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Button x:Name="RateButton" Style="{StaticResource ActionButton}" Margin="0,0,0,10" Height="60" Click="RateLesson_Click" Visibility="Collapsed" Background="White" BorderBrush="#FFDDA800" BorderThickness="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⭐" FontSize="20" Margin="0,0,10,0"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="דרג את המורה שלך" FontSize="16" Foreground="#222" FontWeight="Bold"/>
                                <TextBlock Text="איך הולך הלימוד? שתף אותנו" FontSize="12" Foreground="Gray"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionButton}" Margin="0,0,0,10" Click="FindTeachers_Click" Height="60">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="חפש מורה והזמן שיעור" FontSize="16"/>
                        </StackPanel>
                    </Button>
                    <Button Background="White" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,10" Height="60" BorderBrush="#DDD" BorderThickness="1" Click="Profile_Click" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="הפרופיל שלי" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="TeacherDashboard" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource HeroCard}" Padding="20" Margin="0,0,20,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="📅 הלו&quot;ז שלי להיום" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                            <TextBlock x:Name="TodaysDateText" Text="(10/12/2025)" FontSize="16" Foreground="{StaticResource TextLight}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <DataGrid x:Name="TodaysLessonsGrid" Grid.Row="1" AutoGenerateColumns="False" 
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White" BorderThickness="0" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="שעה" Binding="{Binding StartTime, StringFormat=HH:mm}" Width="80"/>
                                <DataGridTextColumn Header="תלמיד" Binding="{Binding StudentName}" Width="*"/>
                                <DataGridTextColumn Header="מיקום" Binding="{Binding Location}" Width="*"/>
                                <DataGridTextColumn Header="סטטוס" Binding="{Binding StatusName}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Button Grid.Row="2" Content="נהל יומן מלא" Margin="0,15,0,0" Background="{StaticResource PrimaryBlue}" Foreground="White" Padding="10" Click="ManageLessons_Click" Cursor="Hand"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource HeroCard}" Padding="15" Margin="0,0,0,15" Background="#FFF8E1" BorderBrush="#FFECB3">
                        <StackPanel>
                            <TextBlock Text="דירוג מורה" FontSize="16" Foreground="#FF8F00" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10">
                                <TextBlock Text="⭐" FontSize="36" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#FFC107"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TeacherRatingScore" Text="-.-" FontSize="36" FontWeight="Bold" Foreground="#333"/>
                                    <TextBlock Text="ציון ממוצע" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HeroCard}" Padding="15" Margin="0,0,0,15" Background="#F0F4C3">
                        <StackPanel>
                            <TextBlock Text="הספק יומי" FontSize="16" Foreground="#827717" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <TextBlock x:Name="DailyProgressText" Text="0/0" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text=" שיעורים בוצעו" FontSize="16" VerticalAlignment="Bottom" Margin="5,0,0,4" Foreground="{StaticResource TextLight}"/>
                            </StackPanel>
                            <ProgressBar x:Name="DailyProgressBar" Height="8" Margin="0,5,0,0" Background="White" Foreground="#CDDC39" BorderThickness="0" Value="0"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource ActionButton}" Margin="0,0,0,10" Content="התלמידים שלי" Click="MyStudents_Click" Height="40"/>
                    <Button Style="{StaticResource ActionButton}" Margin="0,0,0,10" Content="🚦 ניהול טסטים" Click="ManageTests_Click" Height="40" Background="#FF9800" Foreground="White"/>
                    <Button Background="White" BorderBrush="#DDD" BorderThickness="1" Content="פרופיל אישי" Height="40" Click="Profile_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>