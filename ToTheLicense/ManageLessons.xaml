<Window x:Class="ToTheLicense.ManageLessons"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ניהול שיעורים"
        Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        FontFamily="Segoe UI"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#002366"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#4CAF50"/>
        <SolidColorBrush x:Key="AccentRed" Color="#E53935"/>

        <!-- סגנון כפתור פשוט -->
        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- כותרת עליונה -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBlue}">
            <Grid>
                <Button Content="חזרה" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0"
                        Background="Transparent" Foreground="White" BorderThickness="1" Padding="10,5" Click="BackButton_Click"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📅" FontSize="24" Margin="0,0,10,0"/>
                    <TextBlock Text="ניהול יומן שיעורים" FontSize="22" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- רשימת השיעורים -->
        <ScrollViewer Grid.Row="1" Margin="20" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="LessonsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- כרטיס שיעור -->
                        <Border Margin="0,0,0,15" Background="White" CornerRadius="10" Padding="15">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#DDD" Opacity="0.5" ShadowDepth="2"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- פרטים (ימין) -->
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="{Binding StudentName}" FontSize="18" FontWeight="Bold" Foreground="#333"/>
                                        <TextBlock Text=" | " Foreground="#CCC" Margin="10,0"/>
                                        <TextBlock Text="{Binding VehicleType}" FontSize="14" Foreground="Gray" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <!-- תאריך -->
                                        <Border Background="#E3F2FD" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding StartTime, StringFormat='dd/MM/yyyy'}" Foreground="#1565C0" FontWeight="Bold"/>
                                        </Border>
                                        <!-- שעה -->
                                        <Border Background="#FFF3E0" CornerRadius="4" Padding="8,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StartTime, StringFormat='HH:mm'}" Foreground="#E65100"/>
                                                <TextBlock Text=" - " Foreground="#E65100"/>
                                                <TextBlock Text="{Binding EndTime, StringFormat='HH:mm'}" Foreground="#E65100"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Location, StringFormat='📍 {0}'}" Margin="0,8,0,0" Foreground="#666"/>
                                </StackPanel>

                                <!-- סטטוס וכפתורים (שמאל) -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">

                                    <!-- תגית סטטוס: הצבעים מגיעים ישר מהקוד ב-Model -->
                                    <Border Background="{Binding StatusBackground}" CornerRadius="15" Padding="15,6" HorizontalAlignment="Right" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding DisplayStatus}" Foreground="{Binding StatusColor}" FontWeight="Bold"/>
                                    </Border>

                                    <!-- כפתורים: הנראות מגיעה ישר מהקוד ב-Model -->
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding ButtonsVisibility}">
                                        <Button Content="אשר" Background="{StaticResource AccentGreen}" Style="{StaticResource BtnStyle}" Click="Approve_Click" Tag="{Binding}"/>
                                        <Button Content="דחה" Background="{StaticResource AccentRed}" Style="{StaticResource BtnStyle}" Click="Reject_Click" Tag="{Binding}"/>
                                    </StackPanel>

                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>