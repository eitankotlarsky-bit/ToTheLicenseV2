<Window x:Class="ToTheLicense.RateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="דרג את השיעור" Height="420" Width="350"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft" FontFamily="Segoe UI">

    <!-- חשוב! המשאבים חייבים להיות מוגדרים בהתחלה, לפני השימוש בהם -->
    <Window.Resources>
        <Style x:Key="StarBtn" TargetType="Button">
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="15" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.3"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- כפתור סגירה -->
            <Button Content="✕" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" 
                    FontSize="16" Click="Close_Click" Cursor="Hand" Foreground="#888"/>

            <TextBlock Grid.Row="1" Text="איך היה השיעור?" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center" Foreground="#002366" Margin="0,10"/>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock x:Name="TeacherNameText" Text="עם המורה: ישראל ישראלי" 
                           FontSize="16" FontWeight="SemiBold" Foreground="#333" HorizontalAlignment="Center"/>
                <TextBlock x:Name="LessonDateText" Text="בתאריך 01/01/2025" 
                           FontSize="13" Foreground="Gray" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- כוכבים -->
            <StackPanel Grid.Row="3" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Button x:Name="Star1" Content="★" Style="{StaticResource StarBtn}" Click="Star_Click" Tag="1"/>
                    <Button x:Name="Star2" Content="★" Style="{StaticResource StarBtn}" Click="Star_Click" Tag="2"/>
                    <Button x:Name="Star3" Content="★" Style="{StaticResource StarBtn}" Click="Star_Click" Tag="3"/>
                    <Button x:Name="Star4" Content="★" Style="{StaticResource StarBtn}" Click="Star_Click" Tag="4"/>
                    <Button x:Name="Star5" Content="★" Style="{StaticResource StarBtn}" Click="Star_Click" Tag="5"/>
                </StackPanel>

                <TextBlock x:Name="RatingDescription" Text="בחר דירוג..." HorizontalAlignment="Center" 
                           Foreground="#FFDDA800" FontWeight="Bold" Margin="0,0,0,15"/>

                <TextBlock Text="הערה למורה (אופציונלי):" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#555"/>
                <TextBox x:Name="CommentBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" 
                         BorderBrush="#DDD" BorderThickness="1" Padding="5" VerticalContentAlignment="Top"/>
            </StackPanel>

            <Button Grid.Row="4" Content="שלח דירוג" Height="45" Margin="0,20,0,0"
                    Background="#FFDDA800" Foreground="#222" FontWeight="Bold" FontSize="16"
                    Click="Submit_Click" Cursor="Hand" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>